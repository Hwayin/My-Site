# 统一换行符：脚本/配置在 Linux 上必须是 LF，
# 否则 Windows 上提交后服务器会报 "/bin/bash^M: bad interpreter"
* text=auto eol=lf

*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.js    text eol=lf
*.vue   text eol=lf
*.json  text eol=lf
*.conf  text eol=lf
*.md    text eol=lf

*.png   binary
*.jpg   binary
*.woff2 binary
